{
	// Prompt Generator - Cloudflare Python Worker
	//
	// Serves both the REST API (POST /generate-prompt) and the built React
	// frontend (../frontend/dist) from a single origin.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "prompt-generator",
	"main": "src/entry.py",
	"compatibility_date": "2026-10-15",
	// Required for the Python Workers runtime.
	"compatibility_flags": ["python_workers"],
	// Workers AI binding: available in Python as `self.env.AI` (verified via the
	// official python-workers-examples/workers-ai example and the Python FFI docs).
	"ai": {
		"binding": "AI"
	},
	// Static assets: the built Vite frontend. `run_worker_first` lets the Python
	// worker route API requests itself and delegate everything else to ASSETS.
	"assets": {
		"directory": "../frontend/dist",
		"binding": "ASSETS",
		"not_found_handling": "none",
		"run_worker_first": true
	},
	"vars": {
		// Comma-separated list of frontend origins allowed to call the API
		// cross-origin. Only needed when the frontend is served from a different
		// origin than this worker (e.g. local Vite dev server). Production uses
		// same-origin assets, so no wildcard origins are configured.
		"ALLOWED_ORIGINS": "http://localhost:5173"
	},
	"observability": {
		"enabled": true
	}
}
